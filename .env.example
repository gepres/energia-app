# Narración con voz (ElevenLabs) — plantilla.
# Copia este archivo como `.env` (queda fuera de git) y completa tus datos.
# Las variables NO llevan el prefijo VITE_: así nunca llegan al navegador; solo las lee
# el script que genera los audios (`npm run voz`).

# Clave de la API. En elevenlabs.io/app: tu perfil → «API Keys» → «Create API Key».
# Basta con permiso de «Text to Speech».
ELEVENLABS_API_KEY=

# Voz que narra. En elevenlabs.io/app → «Voices»: elige una en español (o agrégala a «My
# Voices» desde la biblioteca) y copia su «Voice ID» (menú ⋯ de la voz → «Copy voice ID»).
ELEVENLABS_VOICE_ID=

# Modelo. Para narración en español, la documentación recomienda eleven_v4 o
# eleven_multilingual_v2: conviene escuchar los dos con la voz elegida.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Formato del audio (mp3_44100_128 funciona en todos los planes).
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Ajustes de la voz (opcionales; los valores por defecto de ElevenLabs entre paréntesis).
# stability (0.5): más alto, más parejo; más bajo, más expresivo.
ELEVENLABS_STABILITY=0.55
# similarity_boost (0.75): cuánto se parece a la voz original.
ELEVENLABS_SIMILARITY_BOOST=0.75
# style (0): exageración del estilo; 0 para instrucciones tranquilas.
ELEVENLABS_STYLE=0
# speed (1): menos de 1 habla más lento. Para guiar un ejercicio, algo más lento.
ELEVENLABS_SPEED=0.95
